# ==========================================
# Student Performance Prediction & Analytics System
# Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Backend Security
SECRET_KEY=change_me_to_a_secure_random_32_character_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Credentials
# (Obtain these from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_DB_PASSWORD=your_database_password_here

# ML Model Artifacts Directory
ML_ARTIFACTS_DIR=ml/artifacts

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500","*"]
